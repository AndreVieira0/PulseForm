# URL de conexão com o banco de dados SQLite (Padrão para desenvolvimento)
# Em produção, você substituirá por uma URL do PostgreSQL (ex: postgres://user:password@host:port/db)
DATABASE_URL="file:./dev.db"

# Secret usado pelo NextAuth.js para criptografar os tokens de sessão.
# Você pode gerar um novo usando o comando: npx auth secret
AUTH_SECRET="gerar_um_secret_aqui_para_producao"
